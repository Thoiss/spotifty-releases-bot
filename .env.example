# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env: these values give
# full access to your Spotify account and your WhatsApp business number.
# ---------------------------------------------------------------------------

# --- Spotify -------------------------------------------------------------
# From https://developer.spotify.com/dashboard (your app's settings).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Produced once by:  python -m spotify_release_bot authorize
SPOTIFY_REFRESH_TOKEN=

# The playlist new songs are added to. Copy the playlist link in Spotify and
# take the id from it: open.spotify.com/playlist/<THIS_PART>?si=...
SPOTIFY_PLAYLIST_ID=

# Country code used for availability filtering.
SPOTIFY_MARKET=NL

# Which release types to watch. Options: album, single, compilation, appears_on.
# 'appears_on' also catches features, but produces a lot of noise.
SPOTIFY_INCLUDE_GROUPS=album,single

# Pages of releases to fetch per artist (10 per page - Spotify's cap on this
# endpoint). 1 is plenty for a nightly check; raise it temporarily if you ever
# need to look further back.
SPOTIFY_ALBUM_PAGES_PER_ARTIST=1

# Seconds to wait between Spotify API calls. Checking a few hundred followed
# artists means a few hundred requests; fired back to back they trip Spotify's
# rate limiter, and the penalty is a block lasting HOURS, not a short pause.
# 1.0 costs about six minutes for 350 artists, which is nothing for a job that
# runs once a night. Apps still in Development mode get a much smaller quota
# than approved ones, so do not lower this unless you follow few artists. Raise
# it if you ever see a 429 in the logs.
SPOTIFY_REQUEST_DELAY=1.0

# Check only the first N followed artists. 0 = all of them. Set this to 10 for
# a cheap test run: every artist costs one API request, so a full run of a few
# hundred artists is exactly what exhausts the rate limit.
SPOTIFY_MAX_ARTISTS=0

# --- WhatsApp Cloud API --------------------------------------------------
# NOTE: the official Cloud API cannot post into a group chat. Messages go to
# the single number below. See the README for why, and for the alternatives.
WHATSAPP_ENABLED=true

# From Meta for Developers -> your app -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Who receives the notifications: international format, digits only, no '+'.
WHATSAPP_RECIPIENT=31612345678

WHATSAPP_API_VERSION=v21.0

# per_track = one message per song (each gets its own link preview)
# summary   = one message listing every song
WHATSAPP_MESSAGE_MODE=per_track

# Safety net against a flood on a busy release day.
WHATSAPP_MAX_MESSAGES_PER_RUN=25

# STRONGLY RECOMMENDED for a bot that fires at 00:03. Plain text may only be
# sent within 24 hours of your last message to the business number; an approved
# template may be sent at any time. Create a template in WhatsApp Manager whose
# body holds exactly one variable, e.g.  New release: {{1}}
# Leave empty to send plain text instead.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Schedule and behaviour ---------------------------------------------
RUN_AT=00:03
TIMEZONE=Europe/Amsterdam

# How many days back to accept a release date. 2 absorbs timezone differences
# in Spotify's regional publishing without re-posting old material.
LOOKBACK_DAYS=2

STATE_PATH=/data/state.json
STATE_RETENTION_DAYS=180

# true = log what would happen, change nothing.
DRY_RUN=false

LOG_LEVEL=INFO
